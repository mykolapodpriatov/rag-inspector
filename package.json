{
  "name": "rag-inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Retrieval explainer UI for RAG — why a chunk ranked where it did, and what changed between two retrievers.",
  "license": "MIT",
  "author": "Mykola Podpriatov",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "engines": { "node": ">=22.0.0" },
  "packageManager": "pnpm@10.33.2"
}
